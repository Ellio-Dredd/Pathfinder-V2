{
  "version": 2,
  "builds": [
    {
      "src": "backend/main.py",
      "use": "@vercel/python"
    },
    {
      "src": "sos-service/main.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/sos/(.*)",
      "dest": "sos-service/main.py"
    },
    {
      "src": "/api/sos",
      "dest": "sos-service/main.py"
    },
    {
      "src": "/(.*)",
      "dest": "backend/main.py"
    }
  ]
}
