{
  "version": 2,
  "builds": [
    {
      "src": "main.py",
      "use": "@vercel/python"
    },
    {
      "src": "sos.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/sos/(.*)",
      "dest": "sos.py"
    },
    {
      "src": "/api/sos$",
      "dest": "sos.py"
    },
    {
      "src": "/(.*)",
      "dest": "main.py"
    }
  ]
}
